{
  "name": "aoe1web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/assets-import",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @aoe/server\" \"npm run dev -w @aoe/client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @aoe/server",
    "check": "npm run guard && npm run lint && npm run typecheck && npm test",
    "guard": "node tools/check-tracked-files.mjs",
    "assets:verify": "node tools/install-check.mjs",
    "dat:dump": "node --experimental-transform-types tools/dat-dump.mjs",
    "gen:sim-tables": "node --experimental-transform-types tools/gen-sim-tables.mjs",
    "assets:import": "npm run import -w @aoe/assets-import",
    "assets:custom-units": "node tools/custom-units/pack_from_assets_zip.cjs",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:golden": "npm run test:golden --workspaces --if-present",
    "test:e2e": "cd e2e && playwright test",
    "test:e2e:prod": "cd e2e && playwright test -c playwright.prod.config.ts",
    "test:e2e:latency": "cd e2e && playwright test -c playwright.latency.config.ts",
    "test:soak": "cd e2e && playwright test -c playwright.soak.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
